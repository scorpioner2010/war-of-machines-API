# Local developer environment for WarOfMachines API.
# Fill the values you need in .env.local and keep the real file uncommitted.

# ASP.NET
ASPNETCORE_ENVIRONMENT=Development
# ASPNETCORE_URLS=http://127.0.0.1:5000

# Database
# Fill either DATABASE_URL or ConnectionStrings__DefaultConnection.
# The Docker local-development stack uses the following value at runtime:
# DATABASE_URL=Host=127.0.0.1;Port=5433;Database=war_of_machines_local;Username=wom_local;Password=wom_local_dev_password
DATABASE_URL=
ConnectionStrings__DefaultConnection=

# JWT
Jwt__Key=aVeryLongAndRandomJwtSecretKey_MustBeAtLeast32Chars!
