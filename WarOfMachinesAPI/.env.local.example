# Local developer environment for WarOfMachines API.
# Fill the values you need in .env.local and keep the real file uncommitted.

# ASP.NET
ASPNETCORE_ENVIRONMENT=Development
# ASPNETCORE_URLS=http://127.0.0.1:5000

# Database
# Fill either DATABASE_URL or ConnectionStrings__DefaultConnection.
# The Docker local-development stack uses the following value at runtime:
# DATABASE_URL=Host=127.0.0.1;Port=5433;Database=war_of_machines_local;Username=wom_local;Password=wom_local_dev_password
DATABASE_URL=
ConnectionStrings__DefaultConnection=

# JWT (generate a local random value; do not commit the real .env.local)
Jwt__Key=
Jwt__Issuer=WarOfMachines.Api
Jwt__Audience=WarOfMachines.Client

# Dedicated server bootstrap credentials. Use a high-entropy value and keep it secret.
# DedicatedServers__Provisioned__0__ServerId=local-server-1
# DedicatedServers__Provisioned__0__Credential=
# WOM_SERVER_ID=local-server-1
# WOM_SERVER_CREDENTIAL=

# The desktop local launcher creates these process-scoped values outside the repository:
# tools/Initialize-LocalSecurityEnvironment.ps1
# WOM_API_BASE=https://localhost:7216
# WOM_UTP_SERVER_CERTIFICATE=<local PEM certificate path>
# WOM_UTP_SERVER_PRIVATE_KEY=<local PEM private-key path>
# WOM_UTP_SERVER_COMMON_NAME=localhost
# WOM_UTP_CA_CERTIFICATE=<local PEM CA certificate path>
