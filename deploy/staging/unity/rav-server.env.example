# Copy to /etc/rav-staging/unity-server.env (root:rav-staging-server, mode 0640).
# Fill these only after VPS public IPv4 and staging DNS are confirmed.
RAV_API_BASE=https://api.staging.example.invalid
RAV_SERVER_ID=GENERATED_SERVER_ID_FROM_STAGING_SECRETS
RAV_SERVER_CREDENTIAL=GENERATED_SERVER_CREDENTIAL_FROM_STAGING_SECRETS
RAV_SERVER_REGION=EU-STAGING
RAV_SERVER_ADDRESS=REPLACE_WITH_VPS_PUBLIC_IPV4
RAV_SERVER_PORT=7770
RAV_UTP_SERVER_COMMON_NAME=rav-staging-server
