[Unit]
Description=RAV Staging Unity Dedicated Server
Wants=network-online.target
After=network-online.target rav-staging-compose.service
Requires=rav-staging-compose.service

[Service]
Type=simple
User=rav-staging-server
Group=rav-staging-server
WorkingDirectory=/opt/rav-staging/unity/current
EnvironmentFile=/etc/rav-staging/unity-server.env
Environment=HOME=/var/lib/rav-staging
Environment=XDG_CONFIG_HOME=/var/lib/rav-staging/.config
LoadCredential=server.crt:/etc/rav-staging/credentials/dtls_server.crt
LoadCredential=server.key:/etc/rav-staging/credentials/dtls_server.key
LoadCredential=ca.crt:/etc/rav-staging/credentials/dtls_ca.crt
Environment=RAV_UTP_SERVER_CERTIFICATE=%d/server.crt
Environment=RAV_UTP_SERVER_PRIVATE_KEY=%d/server.key
Environment=RAV_UTP_CA_CERTIFICATE=%d/ca.crt
ExecStart=/opt/rav-staging/unity/current/RAVServer.x86_64 -batchmode -nographics -logFile -
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=45s
UMask=0027
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/rav-staging /var/log/rav-staging
StandardOutput=append:/var/log/rav-staging/rav-server.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
