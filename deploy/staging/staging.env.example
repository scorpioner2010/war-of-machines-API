# Copy to /etc/rav-staging/staging.env after DNS and VPS details are verified.
# Credentials and certificates are generated separately into /etc/rav-staging/secrets.
RAV_STAGING_API_HOST=api.staging.example.invalid
RAV_STAGING_SECRETS_DIR=/etc/rav-staging/secrets
RAV_STAGING_POSTGRES_DB=rav_staging
RAV_STAGING_BOOTSTRAP_USER=rav_staging_bootstrap
RAV_STAGING_BACKEND_SUBNET=172.31.240.0/24
RAV_STAGING_CADDY_IP=172.31.240.2
RAV_STAGING_API_IMAGE=rav-api:staging
RAV_STAGING_MIGRATOR_IMAGE=rav-api-migrator:staging
RAV_STAGING_REGION=EU-STAGING
RAV_STAGING_SERVER_ADDRESS=REPLACE_WITH_VPS_PUBLIC_IPV4
RAV_STAGING_DTLS_PROBE=
RAV_STAGING_GAMEPLAY_HARNESS=
