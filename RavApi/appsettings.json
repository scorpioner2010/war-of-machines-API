{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "RunSeedOnStartup": false,
    "SeedDevelopmentFixtures": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Swagger": {
    "Enabled": false
  },
  "DedicatedServers": {
    "HeartbeatTimeoutSeconds": 15,
    "Provisioned": []
  },
  "Authentication": {
    "RefreshTokenLifetimeDays": 30,
    "ConnectionTicketLifetimeSeconds": 30,
    "ServerDelegatedTokenMinutes": 5
  },
  "Jwt": {
    "Key": "",
    "Issuer": "WarOfMachines.Api",
    "Audience": "WarOfMachines.Client",
    "AccessTokenMinutes": 30
  }
}
